  "structures": [
    {
      "id": "nicht-nur",
      "regex": "(?i)\\bnicht nur\\b[^.!?\\n]{2,80}\\bsondern (?:auch\\b)?",
      "name": "\"Nicht nur X, sondern auch Y\"",
      "fix": "Das KI-Deutsch-Muster schlechthin. Zwei Sätze, oder die schwächere Hälfte streichen."
    },
    {
      "id": "nicht-einfach",
      "regex": "(?i)\\b(?:das|es|dies) ist (?:nicht (?:einfach|nur|bloß)|mehr als (?:nur|einfach)?)\\s*(?:ein|eine)\\b[^.!?\\n]{2,60}[.,:]\\s*(?:es|das|sondern)\\b",
      "name": "\"Das ist nicht einfach ein X, es ist Y\"",
      "fix": "Sag das Eine, das du meinst. Die Vorbereitung streichen."
    },
    {
      "id": "geht-nicht-um",
      "regex": "(?i)\\bes geht nicht (?:nur |bloß )?(?:um|darum)\\b[^.!?\\n]{2,60}[.,]\\s*(?:es geht|sondern)\\b",
      "name": "\"Es geht nicht um X. Es geht um Y.\"",
      "fix": "Mit Y anfangen. Die Umkehrung ist das Erkennungszeichen."
    },
    {
      "id": "hier-kommt",
      "regex": "(?i)\\b(?:hier|da) kommt\\b[^.!?\\n]{1,40}\\bins spiel\\b",
      "name": "\"Hier kommt X ins Spiel\"",
      "fix": "Übersetztes Englisch. X einfach einführen."
    },
    {
      "id": "genau-hier",
      "regex": "(?i)\\b(?:genau )?(?:hier|da) setzt\\b[^.!?\\n]{1,40}\\ban\\b",
      "name": "\"Genau hier setzt X an\"",
      "fix": "Werbedeutsch. Sag, was X tut."
    },
    {
      "id": "egal-ob",
      "regex": "(?i)\\begal,? ob\\b[^.!?\\n]{2,60}\\boder\\b",
      "name": "\"Egal, ob X oder Y\"",
      "fix": "Sich für eine Zielgruppe entscheiden. 'Egal ob' heißt: für keinen bestimmten."
    },
    {
      "id": "rhetorische-zeile",
      "regex": "(?im)^\\s*(?:das ergebnis|das beste|der clou|der haken|die lösung|das problem|der grund|und jetzt|die antwort)\\?\\s*$",
      "name": "Rhetorische Ein-Zeilen-Frage",
      "fix": "Direkt im Satz beantworten, statt eine Enthüllung zu inszenieren."
    },
    {
      "id": "doppelpunkt-titel",
      "regex": "(?m)^\\s*(?:Das|Die|Der) (?:Problem|Lösung|Ergebnis|Geheimnis|Fazit|Wichtigste|Beste|Learning)\\s*:\\s*$",
      "name": "Zwischentitel mit Doppelpunkt",
      "fix": "Eine Caption ist kein Foliensatz. Als Satz schreiben."
    },
    {
      "id": "gelernt",
      "regex": "(?i)\\b(?:hier ist,? was|das habe|das hab|folgendes habe) (?:ich|wir) (?:\\w+ )?gelernt\\b",
      "name": "\"Das habe ich gelernt:\"",
      "fix": "Die Lektion sagen. Die Ankündigung streichen."
    },
    {
      "id": "dreier",
      "regex": "\\b(?:[\\wäöüß]+ ){0,2}[\\wäöüß]+, (?:[\\wäöüß]+ ){0,2}[\\wäöüß]+ und (?:[\\wäöüß]+ ){0,2}[\\wäöüß]+[.!]",
      "name": "Dreierreihe \"X, Y und Z.\"",
      "fix": "Zwei oder vier. Drei ist der Standardrhythmus von Sprachmodellen."
    },
    {
      "id": "stell-dir-vor",
      "regex": "(?im)^\\s*(?:stell dir vor|stellen sie sich vor|stellt euch vor)\\b",
      "name": "\"Stell dir vor\"-Einstieg",
      "fix": "Nicht vorstellen lassen, gleich erzählen, was passiert ist."
    },
    {
      "id": "rakete",
      "regex": "[🚀🔥💡✨🎯💪]",
      "name": "Rakete / Feuer / Glühbirne / Glitzer / Zielscheibe / Bizeps",
      "fix": "Höchstens ein Emoji, und keins von diesen sechs."
    },
    {
      "id": "hashtag-wand",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Hashtag-Wand (6+)",
      "fix": "Instagram zählt seit Dezember 2025 nur noch fünf. Drei gute reichen."
    },
    {
      "id": "als-ki",
      "regex": "(?i)\\bals (?:ki|künstliche intelligenz|sprachmodell|ki-modell)\\b",
      "name": "Modell spricht über sich selbst",
      "fix": "Den Satz löschen."
    },
    {
      "id": "zusammenfassend",
      "regex": "(?im)^\\s*(?:zusammenfassend|abschließend|alles in allem|fazit\\s*:|unterm strich|im großen und ganzen)\\b",
      "name": "Aufsatz-Schluss",
      "fix": "Ein Post braucht keinen Schlussabsatz."
    },
    {
      "id": "engagement-koeder",
      "regex": "(?im)(?:was meint ihr|was denkt ihr|was sagt ihr|wer kennt'?s|wer kennt das|seht ihr das auch so|wie seht ihr das|bin ich (?:der|die) einzige|stimmt'?s|oder\\?|was meinen sie|sehen sie das auch so)\\s*\\?*\\s*$",
      "name": "Reflex-Köderfrage am Ende",
      "fix": "Eine Frage stellen, die nur du stellen kannst, über genau das, was darüber steht."
    },
    {
      "id": "stopp-scroll",
      "regex": "(?im)^\\s*(?:hör auf zu scrollen|nicht (?:weiter)?scrollen|stopp!?\\s*$|warte,? nicht scrollen)",
      "name": "\"Hör auf zu scrollen\"-Einstieg",
      "fix": "Der Stopp muss die Aussage selbst sein. Um Aufmerksamkeit zu bitten verrät, dass sie fehlt."
    },
    {
      "id": "video-vorlauf",
      "regex": "(?i)\\b(?:in diesem (?:video|reel|beitrag|clip)|im heutigen (?:video|reel|beitrag)|heute zeige? ich (?:euch|dir|ihnen)|ich zeige? (?:euch|dir|ihnen),? wie)\\b",
      "name": "Video-Vorlauf (\"In diesem Video zeige ich euch\")",
      "fix": "Streichen und beim Ergebnis anfangen. Die ersten zwei Sekunden entscheiden das ganze Reel."
    },
    {
      "id": "emoji-liste",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨▶⭐]\\s*\\S",
      "name": "Emoji-Aufzählung",
      "fix": "Bindestrich oder Zeilenumbruch. Emoji-Aufzählungen sehen am meisten nach Vorlage aus."
    },
    {
      "id": "caps",
      "regex": "\\b[A-ZÄÖÜ]{3,}\\b(?:\\s+\\b[A-ZÄÖÜ]{3,}\\b){2,}",
      "name": "Drei oder mehr Wörter in Großbuchstaben",
      "fix": "Großbuchstaben sind ein Lautstärkeregler, kein Textmarker. Ein Wort, höchstens."
    },
    {
      "id": "folge-koeder",
      "regex": "(?i)\\b(?:folg(?:e|t)? (?:mir|uns) für mehr|markier(?:e)? jemanden|teile? das mit jemandem|doppelt tippen,? wenn|kommentier\\w* ein emoji)\\b",
      "name": "Reflex-Folge- oder Markier-Köder",
      "fix": "Um den einen Schritt bitten, den dieser Post wirklich verdient. Der generische Köder bringt das Publikum dazu, jede Bitte zu überlesen."
    },
    {
      "id": "firmen-freude",
      "regex": "(?i)\\bwir (?:freuen uns|sind stolz|sind froh)\\b",
      "name": "Firmen-Freude (\"Wir freuen uns\")",
      "fix": "Keiner scrollt, um zu hören, dass Sie sich freuen. Mit dem Nutzen für den Kunden anfangen."
    },
    {
      "id": "gedankenstriche",
      "regex": "(?:\\s[–—]\\s[^\\n]*){3,}",
      "name": "Gedankenstrich-Häufung",
      "fix": "Drei Gedankenstriche in einem Text sind ein Fingerabdruck. Punkt, Komma oder Doppelpunkt."
    }
  ]
}
